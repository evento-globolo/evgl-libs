{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evento-globolo.github.io/schemas/event-envelope.schema.json",
  "title": "Evento Globolo EventEnvelope",
  "type": "object",
  "required": [
    "id",
    "kind",
    "occurredAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+\\.[a-z0-9_.-]+$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
